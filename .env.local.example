# Directus URL that the Next.js app reads from at runtime.
# Local dev: http://localhost:8055 (docker compose default).
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# Static read-only token issued to the "viewer" role in Directus.
# Issued by scripts/bootstrap-directus.ts and printed to the terminal.
NEXT_PUBLIC_DIRECTUS_TOKEN=

# Base URL used by the toolbar's "Manage Accounts" deep-link.
# Usually the same host as NEXT_PUBLIC_DIRECTUS_URL plus /admin.
NEXT_PUBLIC_DIRECTUS_ADMIN_URL=http://localhost:8055/admin

# Admin email + password for the bootstrap and seed scripts.
# These must match what docker-compose.yml launches Directus with.
# Never commit real values.
DIRECTUS_ADMIN_EMAIL=admin@vegeta.local
DIRECTUS_ADMIN_PASSWORD=admin
