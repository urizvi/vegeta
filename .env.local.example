# Public Directus URL — used by the browser for data fetches.
# Local dev: http://localhost:8055 (docker compose default).
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# Server-only Directus URL — used by Next API routes (login/refresh/logout proxies).
# In local dev this matches NEXT_PUBLIC_DIRECTUS_URL; in prod it can be an internal hostname.
DIRECTUS_URL=http://localhost:8055

# Base URL used by the toolbar's "Manage Accounts" deep-link.
# Usually the same host as NEXT_PUBLIC_DIRECTUS_URL plus /admin.
NEXT_PUBLIC_DIRECTUS_ADMIN_URL=http://localhost:8055/admin

# Admin email + password for the bootstrap script.
# Must match what docker-compose.yml launches Directus with. Never commit real values.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=admin

# Directus session-cookie attributes (consumed by docker-compose via env).
# Dev: localhost. Prod: parent domain shared by Next and Directus, e.g. .example.com
# SESSION_COOKIE_DOMAIN=localhost
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAME_SITE=lax

# ─── WaferIQ pivot flags ──────────────────────────────────────────────────────
# Enable the parked territory-planning UI (routes + map components). Off by
# default post-pivot. Set to "1" or "true" to expose /territory again.
# NEXT_PUBLIC_LEGACY_TERRITORY_ENABLED=
